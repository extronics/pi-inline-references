{
  "name": "pi-inline-references",
  "version": "0.1.0",
  "description": "pi extension that resolves inline @path.md references in Markdown files that the read tool reads",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "markdown",
    "references"
  ],
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/inline-references/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0"
  }
}
